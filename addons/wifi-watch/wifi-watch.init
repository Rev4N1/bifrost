#!/bin/sh /etc/rc.common
# procd service wrapper for wifi-watch.sh
# Installed as /etc/init.d/wifi-watch on the main router

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/wifi-watch.sh
	procd_set_param file /etc/wifi-watch.conf
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

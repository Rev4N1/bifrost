# ========================================================
# bifrost.conf - every setting and secret, in one file.
# deploy.sh reads it and gives each device only its part.
#
#   cp -n bifrost.conf.example bifrost.conf
#
# Git-ignored; keep a backup somewhere safe (it holds every
# password). Fill in every CHANGE_ME. Parts 5 and 6 are
# optional and stay off while left empty. IPv4 only.
# ========================================================


# ======== 1. Basics ========

# Your LAN (the main router is the gateway)
GW_IP="192.168.1.1"
NETMASK="255.255.255.0"     # contiguous mask; every AP IP must be in this subnet

# Where you are: legal Wi-Fi channels and power, and the clock
COUNTRY="CHANGE_ME"         # ISO 3166 code, e.g. DE, FR, US
ZONENAME="CHANGE_ME"        # e.g. Europe/Berlin
TIMEZONE="CHANGE_ME"        # POSIX TZ for it, e.g. CET-1CEST,M3.5.0,M10.5.0/3
NTP_SERVER="pool.ntp.org"

# Root password on every router. deploy.sh sets it, and logs in with it
# (or with an empty one, on a factory router).
ROOT_PASSWORD="CHANGE_ME"


# ======== 2. Internet (main router) ========

WAN_DEVICE="eth1"           # the WAN port's name: on a factory router, uci get network.wan.device
PPPOE_USER="CHANGE_ME"
PPPOE_PASS="CHANGE_ME"
DNS_LIST="9.9.9.11 149.112.112.11"   # upstream resolvers, space separated; when set, only these; empty = the WAN's
                            # Clients always use the router as DNS, so this list cannot be bypassed.
UPNP="0"                    # 1 = UPnP/NAT-PMP on (lets consoles and apps open ports)


# ======== 3. Wi-Fi (identical on every router, for roaming) ========

SSID="CHANGE_ME"
WPA_PSK="CHANGE_ME"
MOBILITY_DOMAIN="a1b2"      # 802.11r, any 4 hex digits
BW24="20"                   # 2.4 GHz width (MHz)
BW5="80"                    # 5 GHz width (MHz)
TXPOWER_24="17"             # 2.4 GHz power in dBm (1-30), lower so devices prefer 5 GHz. Empty = max


# ======== 4. Routers and channels ========
# 2.4 GHz: use 1, 6 and 11. 5 GHz at 80 MHz: 36 = 36-48 (no DFS),
# 52 = 52-64 (DFS), 100 = 100-112 (DFS), 149 = 149-161 (no DFS in
# most countries). With three APs, put each on a different 80 MHz
# block; APs that cannot hear each other may share one. Channels
# 100+ are not visible to every client, so 149 is the safer third
# choice. The router applies COUNTRY, so only legal channels work.

MAIN_HOSTNAME="router-main"
MAIN_CH24="1"
MAIN_CH5="36"

# Dumb APs: "hostname,ip,ch24,ch5", space separated
APS="ap1,192.168.1.2,6,52 ap2,192.168.1.3,11,149"


# ======== 5. Telegram home/away bot (optional: off while BOT_TOKEN is empty) ========

BOT_TOKEN=""                # from @BotFather
CHAT_ID=""                  # group or user chat id
PEOPLE=""                   # "<DHCP hostname part>=<name>", e.g. "Pixel-8=Alice iPhone-Bob=Bob"
PEOPLE_MAC=""               # for devices with no DHCP hostname: "aa:bb:cc:dd:ee:ff=Alice"

# Tuning (addons/wifi-watch/README.md explains each)
POLL_INTERVAL=30            # seconds between checks
MISSES_TO_LEAVE=4           # failed checks in a row before "left"
CONFIRM_ROUNDS=3            # extra checks before sending "left"
CONFIRM_GAP=5               # seconds between those
ARPING_TRIES=3              # ARP requests per check
INITIAL_SETTLE=45           # seconds to wait after a start
AP_FAIL_GRACE=10            # checks an AP may be unreachable before it's ignored


# ======== 6. WireGuard VPN on the main router (optional: off while WG_PORT is empty) ========
# Seeds the router once (addons/wireguard/README.md); after the
# first deploy, edit it in LuCI and these values are no longer read,
# except VPN_LAN_ACCESS, which every deploy applies exactly.

WG_PORT=""                  # e.g. 51820 (WireGuard's usual port) to turn it on
VPN_SUBNET="10.7.0.0/24"    # a /24 that must not overlap the LAN: router .1, clients .2+
CLIENT_DNS=""               # DNS for clients, e.g. "9.9.9.9, 1.1.1.1"; empty = no DNS line, they keep their own
VPN_LAN_ACCESS=""           # LAN services VPN clients may reach, "ip:proto:port", e.g. "192.168.1.20:tcp:3389"
                            # (everything else on the LAN is blocked; give those hosts static IPs).
                            # Synced every deploy: an entry removed here is removed from the router.
                            # New clients route only these hosts through the tunnel; empty = all (0.0.0.0/0).

# DuckDNS keeps <subdomain>.duckdns.org pointing at your home IP (empty = clients use the WAN IP)
DUCKDNS_DOMAIN=""           # subdomain only, without .duckdns.org
DUCKDNS_TOKEN=""            # required when DUCKDNS_DOMAIN is set

# ========================================================
# Pi WireGuard gateway settings. Read by pi/setup.sh on the
# Pi (deploy.sh copies it over for each run, then deletes it).
#
# pi.conf is git-ignored; this .example is the committed
# template:  cp -n pi.conf.example pi.conf
# ========================================================

# ---- Network (must match router/setup/network.conf) ----
PI_IP="192.168.1.5"
LAN_SUBNET="192.168.1.0/24"

# ---- WireGuard ----
WG_PORT="51820"
VPN_SUBNET="10.7.0.0/24"     # the Pi is .1, clients from .2 up
CLIENT_DNS="9.9.9.9, 1.1.1.1"

# ---- DuckDNS: keeps <subdomain>.duckdns.org pointing at home ----
# Empty token = keep whatever the Pi already has.
DUCKDNS_DOMAIN="CHANGE_ME"   # subdomain only, without .duckdns.org
DUCKDNS_TOKEN=""

# ---- LAN services VPN clients may reach (everything else on the LAN
# is blocked). "ip:proto:port" entries, space separated. Give those
# hosts static IPs.
VPN_LAN_ACCESS=""
# VPN_LAN_ACCESS="192.168.1.20:tcp:3389 192.168.1.20:udp:3389 192.168.1.30:tcp:22"

# ---- USB MACs. Empty = keep what's pinned, or freeze this boot's
# random ones. Set them (deploy.sh pi-gateway records them in
# router/addon-pi-gateway/pi-gateway.conf) to give a reflashed Pi its
# old MACs, so the router's static lease still matches.
PI_MAC=""
HOST_MAC=""

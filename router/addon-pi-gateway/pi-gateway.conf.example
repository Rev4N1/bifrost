# ========================================================
# addon-pi-gateway configuration. Read by install.sh on the
# main router; the router side of the Pi (see pi/README.md).
#
# pi-gateway.conf is git-ignored; this .example is the
# committed template:
#   cp pi-gateway.conf.example pi-gateway.conf   # then fill it in
# ========================================================

# The Pi, as the router sees it
PI_NAME="pi-zero-2w"
PI_MAC="CHANGE_ME"          # the Pi's usb0 MAC: deploy.sh pi-gateway <user>@<pi> fills it in
PI_IP="192.168.1.5"
PI_PORT="usb0"              # router-side interface the Pi appears as

# WireGuard: forwarded from WAN to the Pi
WG_PORT="51820"

# ========================================================
# The whole router layout and every secret the setup scripts
# use. Sourced by main-router.sh, dumb-ap.sh and deploy.sh.
#
# network.conf is git-ignored; this .example is the committed
# template:  cp -n network.conf.example network.conf
# The scripts refuse to run while a CHANGE_ME is left.
# ========================================================

# ---- Wi-Fi: identical on every router (roaming needs it) ----
SSID="CHANGE_ME"
WPA_PSK="CHANGE_ME"
COUNTRY="CHANGE_ME"         # ISO 3166 code: legal channels/power (e.g. DE, FR, US)
MOBILITY_DOMAIN="a1b2"      # 802.11r, any 4 hex digits
BW24="20"                   # 2.4 GHz width (MHz)
BW5="80"                    # 5 GHz width (MHz)
TXPOWER_24="17"             # 2.4 GHz dBm; lower than 5 GHz so clients prefer 5 GHz. Empty = max

# ---- Main router ----
MAIN_HOSTNAME="router-main"
GW_IP="192.168.1.1"
NETMASK="255.255.255.0"
WAN_DEVICE="eth1"           # the WAN port's name in OpenWrt (uci show network | grep wan)
PPPOE_USER="CHANGE_ME"
PPPOE_PASS="CHANGE_ME"
MAIN_CH24="1"
MAIN_CH5="36"
DNS_LIST="9.9.9.11 149.112.112.11"   # upstream resolvers
DHCP_DNS_OPTION=""          # DNS handed to clients; empty = the router. e.g. "6,192.168.1.1,9.9.9.9"

# ---- Dumb APs: "hostname,ip,ch24,ch5", space separated ----
# Channels must not overlap the main router or each other. At 80 MHz:
# 36 = 36-48, 52 = 52-64 (DFS), 100 = 100-112 (DFS). 2.4 GHz: 1, 6, 11.
APS="ap1,192.168.1.2,6,100 ap2,192.168.1.3,11,52"

# ---- Every router ----
ROOT_PASSWORD="CHANGE_ME"
ZONENAME="CHANGE_ME"        # e.g. Europe/Berlin
TIMEZONE="CHANGE_ME"        # POSIX TZ for it, e.g. CET-1CEST,M3.5.0,M10.5.0/3
NTP_SERVER="pool.ntp.org"
